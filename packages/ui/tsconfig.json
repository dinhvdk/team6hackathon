{
  "compilerOptions": {
    "lib": ["dom", "es6"],
    "resolveJsonModule": true,
    "baseUrl": ".",
    "declaration": false,
    "declarationMap": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@repo/ui/*": ["./index.tsx"]
    }
  },
  "extends": "@repo/typescript-config/react-library.json",
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.svg",
    "../../apps/**/*",
    "../plugins/nftAggregator/src/components/NFTInfo.tsx",
    "../plugins/nftAggregator/src/components/TableNFTs.tsx",
    "../plugins/nftAggregator/src/components/TableWatchList.tsx",
    "../plugins/nftAggregator/src/components/apis.ts"
  ],
  "exclude": ["dist", "build", "node_modules"]
}
